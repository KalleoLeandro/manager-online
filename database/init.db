

CREATE TABLE IF NOT EXISTS managers (
    id VARCHAR(36) PRIMARY KEY,
    name VARCHAR(40) NOT NULL,
    email VARCHAR(254) NOT NULL UNIQUE,
    password_hash VARCHAR(256) NOT NULL,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS catalog_leagues (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, name VARCHAR(100) NOT NULL, country VARCHAR(100) NOT NULL,
    selectable BOOLEAN NOT NULL, season VARCHAR(200) NOT NULL, team_count INTEGER NOT NULL
);
CREATE TABLE IF NOT EXISTS catalog_teams (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, league_id BIGINT NOT NULL REFERENCES catalog_leagues(id),
    name VARCHAR(150) NOT NULL, short_name VARCHAR(150) NOT NULL, abbreviation VARCHAR(20) NOT NULL,
    crest_url VARCHAR(1000), color VARCHAR(12), rating INTEGER NOT NULL CHECK (rating BETWEEN 1 AND 99),
    national_rank INTEGER NOT NULL, international_bonus DECIMAL(4,1) NOT NULL,
    selectable BOOLEAN NOT NULL, source_url VARCHAR(1000)
);
CREATE TABLE IF NOT EXISTS catalog_players (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, team_id BIGINT NOT NULL REFERENCES catalog_teams(id),
    name VARCHAR(150) NOT NULL, position VARCHAR(12) NOT NULL, level VARCHAR(30) NOT NULL,
    ability INTEGER NOT NULL CHECK (ability BETWEEN 1 AND 99),
    attribute1 VARCHAR(40) NOT NULL, value1 INTEGER NOT NULL CHECK (value1 BETWEEN 1 AND 99),
    attribute2 VARCHAR(40) NOT NULL, value2 INTEGER NOT NULL CHECK (value2 BETWEEN 1 AND 99),
    age INTEGER, shirt_number VARCHAR(20), photo_url VARCHAR(1000), nationality VARCHAR(100),
    appearances INTEGER NOT NULL, goals INTEGER NOT NULL, assists INTEGER NOT NULL, minutes INTEGER NOT NULL,
    source_url VARCHAR(1000)
);
CREATE TABLE IF NOT EXISTS game_saves (
    id VARCHAR(36) PRIMARY KEY, name VARCHAR(60) NOT NULL, invite_code VARCHAR(12) NOT NULL UNIQUE,
    capacity INTEGER NOT NULL CHECK (capacity BETWEEN 1 AND 20), status VARCHAR(20) NOT NULL DEFAULT 'LOBBY',
    catalog_version VARCHAR(64) NOT NULL, round_number INTEGER NOT NULL DEFAULT 1,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS save_teams (
    save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id), team_id BIGINT NOT NULL,
    league_id BIGINT NOT NULL, name VARCHAR(150) NOT NULL, short_name VARCHAR(150) NOT NULL,
    abbreviation VARCHAR(20) NOT NULL, crest_url VARCHAR(1000), rating INTEGER NOT NULL,
    selectable BOOLEAN NOT NULL, budget BIGINT NOT NULL DEFAULT 10000000,
    points INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(save_id, team_id)
);
CREATE TABLE IF NOT EXISTS save_players (
    save_id VARCHAR(36) NOT NULL, player_id BIGINT NOT NULL, team_id BIGINT NOT NULL,
    name VARCHAR(150) NOT NULL, position VARCHAR(12) NOT NULL, level VARCHAR(30) NOT NULL,
    ability INTEGER NOT NULL CHECK (ability BETWEEN 1 AND 99), attribute1 VARCHAR(40) NOT NULL,
    value1 INTEGER NOT NULL, attribute2 VARCHAR(40) NOT NULL, value2 INTEGER NOT NULL,
    age INTEGER, shirt_number VARCHAR(20), photo_url VARCHAR(1000), nationality VARCHAR(100),
    fitness INTEGER NOT NULL DEFAULT 100, PRIMARY KEY(save_id, player_id),
    FOREIGN KEY(save_id, team_id) REFERENCES save_teams(save_id, team_id)
);
CREATE TABLE IF NOT EXISTS save_members (
    id VARCHAR(36) PRIMARY KEY, save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id),
    name VARCHAR(40) NOT NULL, team_id BIGINT NOT NULL, owner BOOLEAN NOT NULL,
    ready BOOLEAN NOT NULL DEFAULT FALSE, token_hash VARCHAR(64) NOT NULL UNIQUE,
    joined_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(save_id, team_id), FOREIGN KEY(save_id, team_id) REFERENCES save_teams(save_id, team_id)
);
CREATE INDEX IF NOT EXISTS idx_catalog_players_team ON catalog_players(team_id);
CREATE INDEX IF NOT EXISTS idx_save_members_save ON save_members(save_id);
ALTER TABLE save_members ADD COLUMN IF NOT EXISTS manager_id VARCHAR(36) REFERENCES managers(id);
CREATE INDEX IF NOT EXISTS idx_save_members_manager ON save_members(manager_id);
CREATE TABLE IF NOT EXISTS manager_sessions (
    token_hash VARCHAR(64) PRIMARY KEY, manager_id VARCHAR(36) NOT NULL REFERENCES managers(id),
    expires_at TIMESTAMP NOT NULL
);
CREATE TABLE IF NOT EXISTS save_team_management (
    save_id VARCHAR(36) NOT NULL, team_id BIGINT NOT NULL,
    formation VARCHAR(10) NOT NULL, mentality VARCHAR(20) NOT NULL, version INTEGER NOT NULL,
    PRIMARY KEY(save_id,team_id), FOREIGN KEY(save_id,team_id) REFERENCES save_teams(save_id,team_id)
);
CREATE TABLE IF NOT EXISTS save_lineups (
    save_id VARCHAR(36) NOT NULL, team_id BIGINT NOT NULL,
    slot_index INTEGER NOT NULL CHECK(slot_index BETWEEN 0 AND 10), player_id BIGINT NOT NULL,
    PRIMARY KEY(save_id,team_id,slot_index), UNIQUE(save_id,team_id,player_id),
    FOREIGN KEY(save_id,team_id) REFERENCES save_teams(save_id,team_id),
    FOREIGN KEY(save_id,player_id) REFERENCES save_players(save_id,player_id)
);

-- Idempotent additions preserve existing save snapshots.
ALTER TABLE catalog_leagues ADD COLUMN IF NOT EXISTS division INTEGER NOT NULL DEFAULT 1;
ALTER TABLE catalog_leagues ADD COLUMN IF NOT EXISTS source_url VARCHAR(1000);
ALTER TABLE catalog_teams ADD COLUMN IF NOT EXISTS group_name VARCHAR(40);
ALTER TABLE catalog_players ADD COLUMN IF NOT EXISTS generated BOOLEAN NOT NULL DEFAULT FALSE;
ALTER TABLE catalog_players ADD COLUMN IF NOT EXISTS generation_origin VARCHAR(32);
ALTER TABLE save_players ADD COLUMN IF NOT EXISTS generated BOOLEAN NOT NULL DEFAULT FALSE;
ALTER TABLE save_players ADD COLUMN IF NOT EXISTS generation_origin VARCHAR(32);
ALTER TABLE game_saves ADD COLUMN IF NOT EXISTS last_activity_at TIMESTAMP;
-- Existing leagues get the full retention period when this feature is activated.
UPDATE game_saves SET last_activity_at=CURRENT_TIMESTAMP WHERE last_activity_at IS NULL;
ALTER TABLE game_saves ALTER COLUMN last_activity_at SET DEFAULT CURRENT_TIMESTAMP;
ALTER TABLE game_saves ALTER COLUMN last_activity_at SET NOT NULL;
CREATE INDEX IF NOT EXISTS idx_game_saves_activity ON game_saves(last_activity_at);

-- Current catalogue metadata, not an import history.
CREATE TABLE IF NOT EXISTS catalog_metadata (
    id INTEGER PRIMARY KEY CHECK (id=1), version VARCHAR(64) NOT NULL,
    source VARCHAR(500) NOT NULL, rating_method VARCHAR(3000) NOT NULL,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
ALTER TABLE catalog_leagues ADD COLUMN IF NOT EXISTS display_order INTEGER NOT NULL DEFAULT 0;
ALTER TABLE catalog_teams ADD COLUMN IF NOT EXISTS display_order INTEGER NOT NULL DEFAULT 0;

CREATE TABLE IF NOT EXISTS catalog_team_palettes (
    team_id BIGINT PRIMARY KEY REFERENCES catalog_teams(id),
    primary_color VARCHAR(7) NOT NULL, secondary_color VARCHAR(7) NOT NULL,
    away_verified BOOLEAN NOT NULL, away_accent VARCHAR(7), away_source VARCHAR(1000),
    home_accent VARCHAR(7) NOT NULL, home_source VARCHAR(1000), home_method VARCHAR(16) NOT NULL,
    home_reference VARCHAR(3000), home_collected_at VARCHAR(40), away_collected_at VARCHAR(40)
);
CREATE TABLE IF NOT EXISTS catalog_palette_colors (
    team_id BIGINT NOT NULL REFERENCES catalog_team_palettes(team_id),
    sort_order INTEGER NOT NULL, color VARCHAR(7) NOT NULL, PRIMARY KEY(team_id,sort_order)
);
CREATE TABLE IF NOT EXISTS catalog_roster_policies (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, country VARCHAR(100) NOT NULL, season VARCHAR(200) NOT NULL,
    reference VARCHAR(100), window_start DATE, window_end DATE, source_url VARCHAR(1000),
    verification VARCHAR(200), note VARCHAR(3000)
);
CREATE TABLE IF NOT EXISTS catalog_roster_policy_leagues (
    policy_id BIGINT NOT NULL REFERENCES catalog_roster_policies(id),
    league_id BIGINT NOT NULL REFERENCES catalog_leagues(id), PRIMARY KEY(policy_id,league_id)
);
CREATE TABLE IF NOT EXISTS save_roster_policies (
    save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id), policy_id BIGINT NOT NULL,
    country VARCHAR(100) NOT NULL, season VARCHAR(200) NOT NULL, reference VARCHAR(100),
    window_start DATE, window_end DATE, source_url VARCHAR(1000), verification VARCHAR(200), note VARCHAR(3000),
    PRIMARY KEY(save_id,policy_id)
);
CREATE TABLE IF NOT EXISTS save_roster_policy_leagues (
    save_id VARCHAR(36) NOT NULL, policy_id BIGINT NOT NULL, league_id BIGINT NOT NULL,
    PRIMARY KEY(save_id,policy_id,league_id),
    FOREIGN KEY(save_id,policy_id) REFERENCES save_roster_policies(save_id,policy_id)
);

-- Source identifiers are import references, never asset filenames or primary keys.
ALTER TABLE catalog_leagues ADD COLUMN IF NOT EXISTS source_id VARCHAR(80) UNIQUE;
ALTER TABLE catalog_teams ADD COLUMN IF NOT EXISTS source_id VARCHAR(80) UNIQUE;
ALTER TABLE catalog_players ADD COLUMN IF NOT EXISTS source_id VARCHAR(80) UNIQUE;
ALTER TABLE catalog_roster_policies ADD COLUMN IF NOT EXISTS source_key VARCHAR(40) UNIQUE;

-- Permanent player skills, separate from temporary match condition.
CREATE TABLE IF NOT EXISTS catalog_player_profiles (player_id BIGINT PRIMARY KEY REFERENCES catalog_players(id) ON DELETE CASCADE,reference_ability INTEGER NOT NULL CHECK(reference_ability BETWEEN 1 AND 99),potential INTEGER NOT NULL CHECK(potential BETWEEN 1 AND 99),source_mask BIGINT NOT NULL DEFAULT 0,source_name VARCHAR(100),source_url VARCHAR(1000),origin VARCHAR(30) NOT NULL DEFAULT 'INITIAL_ESTIMATE',shot_power INTEGER NOT NULL CHECK (shot_power BETWEEN 1 AND 99),
long_shots INTEGER NOT NULL CHECK (long_shots BETWEEN 1 AND 99),
dribbling INTEGER NOT NULL CHECK (dribbling BETWEEN 1 AND 99),
technique INTEGER NOT NULL CHECK (technique BETWEEN 1 AND 99),
crossing INTEGER NOT NULL CHECK (crossing BETWEEN 1 AND 99),
vision INTEGER NOT NULL CHECK (vision BETWEEN 1 AND 99),
finishing INTEGER NOT NULL CHECK (finishing BETWEEN 1 AND 99),
short_passing INTEGER NOT NULL CHECK (short_passing BETWEEN 1 AND 99),
long_passing INTEGER NOT NULL CHECK (long_passing BETWEEN 1 AND 99),
tackling INTEGER NOT NULL CHECK (tackling BETWEEN 1 AND 99),
marking INTEGER NOT NULL CHECK (marking BETWEEN 1 AND 99),
heading INTEGER NOT NULL CHECK (heading BETWEEN 1 AND 99),
first_touch INTEGER NOT NULL CHECK (first_touch BETWEEN 1 AND 99),
off_ball INTEGER NOT NULL CHECK (off_ball BETWEEN 1 AND 99),
free_kicks INTEGER NOT NULL CHECK (free_kicks BETWEEN 1 AND 99),
corners INTEGER NOT NULL CHECK (corners BETWEEN 1 AND 99),
penalties INTEGER NOT NULL CHECK (penalties BETWEEN 1 AND 99),
anticipation INTEGER NOT NULL CHECK (anticipation BETWEEN 1 AND 99),
aggression INTEGER NOT NULL CHECK (aggression BETWEEN 1 AND 99),
composure INTEGER NOT NULL CHECK (composure BETWEEN 1 AND 99),
concentration INTEGER NOT NULL CHECK (concentration BETWEEN 1 AND 99),
decisions INTEGER NOT NULL CHECK (decisions BETWEEN 1 AND 99),
determination INTEGER NOT NULL CHECK (determination BETWEEN 1 AND 99),
teamwork INTEGER NOT NULL CHECK (teamwork BETWEEN 1 AND 99),
leadership INTEGER NOT NULL CHECK (leadership BETWEEN 1 AND 99),
consistency INTEGER NOT NULL CHECK (consistency BETWEEN 1 AND 99),
acceleration INTEGER NOT NULL CHECK (acceleration BETWEEN 1 AND 99),
pace INTEGER NOT NULL CHECK (pace BETWEEN 1 AND 99),
work_rate INTEGER NOT NULL CHECK (work_rate BETWEEN 1 AND 99),
strength INTEGER NOT NULL CHECK (strength BETWEEN 1 AND 99),
agility INTEGER NOT NULL CHECK (agility BETWEEN 1 AND 99),
jumping INTEGER NOT NULL CHECK (jumping BETWEEN 1 AND 99),
stamina INTEGER NOT NULL CHECK (stamina BETWEEN 1 AND 99),
injury_resistance INTEGER NOT NULL CHECK (injury_resistance BETWEEN 1 AND 99),
reflexes INTEGER NOT NULL CHECK (reflexes BETWEEN 1 AND 99),
handling INTEGER NOT NULL CHECK (handling BETWEEN 1 AND 99),
gk_positioning INTEGER NOT NULL CHECK (gk_positioning BETWEEN 1 AND 99),
one_on_ones INTEGER NOT NULL CHECK (one_on_ones BETWEEN 1 AND 99),
kicking INTEGER NOT NULL CHECK (kicking BETWEEN 1 AND 99),
diving INTEGER NOT NULL CHECK (diving BETWEEN 1 AND 99));
CREATE TABLE IF NOT EXISTS save_player_profiles(save_id VARCHAR(36) NOT NULL,player_id BIGINT NOT NULL,reference_ability INTEGER NOT NULL CHECK(reference_ability BETWEEN 1 AND 99),potential INTEGER NOT NULL CHECK(potential BETWEEN 1 AND 99),source_mask BIGINT NOT NULL DEFAULT 0,source_name VARCHAR(100),source_url VARCHAR(1000),origin VARCHAR(30) NOT NULL DEFAULT 'INITIAL_ESTIMATE',shot_power INTEGER NOT NULL CHECK (shot_power BETWEEN 1 AND 99),
long_shots INTEGER NOT NULL CHECK (long_shots BETWEEN 1 AND 99),
dribbling INTEGER NOT NULL CHECK (dribbling BETWEEN 1 AND 99),
technique INTEGER NOT NULL CHECK (technique BETWEEN 1 AND 99),
crossing INTEGER NOT NULL CHECK (crossing BETWEEN 1 AND 99),
vision INTEGER NOT NULL CHECK (vision BETWEEN 1 AND 99),
finishing INTEGER NOT NULL CHECK (finishing BETWEEN 1 AND 99),
short_passing INTEGER NOT NULL CHECK (short_passing BETWEEN 1 AND 99),
long_passing INTEGER NOT NULL CHECK (long_passing BETWEEN 1 AND 99),
tackling INTEGER NOT NULL CHECK (tackling BETWEEN 1 AND 99),
marking INTEGER NOT NULL CHECK (marking BETWEEN 1 AND 99),
heading INTEGER NOT NULL CHECK (heading BETWEEN 1 AND 99),
first_touch INTEGER NOT NULL CHECK (first_touch BETWEEN 1 AND 99),
off_ball INTEGER NOT NULL CHECK (off_ball BETWEEN 1 AND 99),
free_kicks INTEGER NOT NULL CHECK (free_kicks BETWEEN 1 AND 99),
corners INTEGER NOT NULL CHECK (corners BETWEEN 1 AND 99),
penalties INTEGER NOT NULL CHECK (penalties BETWEEN 1 AND 99),
anticipation INTEGER NOT NULL CHECK (anticipation BETWEEN 1 AND 99),
aggression INTEGER NOT NULL CHECK (aggression BETWEEN 1 AND 99),
composure INTEGER NOT NULL CHECK (composure BETWEEN 1 AND 99),
concentration INTEGER NOT NULL CHECK (concentration BETWEEN 1 AND 99),
decisions INTEGER NOT NULL CHECK (decisions BETWEEN 1 AND 99),
determination INTEGER NOT NULL CHECK (determination BETWEEN 1 AND 99),
teamwork INTEGER NOT NULL CHECK (teamwork BETWEEN 1 AND 99),
leadership INTEGER NOT NULL CHECK (leadership BETWEEN 1 AND 99),
consistency INTEGER NOT NULL CHECK (consistency BETWEEN 1 AND 99),
acceleration INTEGER NOT NULL CHECK (acceleration BETWEEN 1 AND 99),
pace INTEGER NOT NULL CHECK (pace BETWEEN 1 AND 99),
work_rate INTEGER NOT NULL CHECK (work_rate BETWEEN 1 AND 99),
strength INTEGER NOT NULL CHECK (strength BETWEEN 1 AND 99),
agility INTEGER NOT NULL CHECK (agility BETWEEN 1 AND 99),
jumping INTEGER NOT NULL CHECK (jumping BETWEEN 1 AND 99),
stamina INTEGER NOT NULL CHECK (stamina BETWEEN 1 AND 99),
injury_resistance INTEGER NOT NULL CHECK (injury_resistance BETWEEN 1 AND 99),
reflexes INTEGER NOT NULL CHECK (reflexes BETWEEN 1 AND 99),
handling INTEGER NOT NULL CHECK (handling BETWEEN 1 AND 99),
gk_positioning INTEGER NOT NULL CHECK (gk_positioning BETWEEN 1 AND 99),
one_on_ones INTEGER NOT NULL CHECK (one_on_ones BETWEEN 1 AND 99),
kicking INTEGER NOT NULL CHECK (kicking BETWEEN 1 AND 99),
diving INTEGER NOT NULL CHECK (diving BETWEEN 1 AND 99),morale INTEGER NOT NULL DEFAULT 100 CHECK(morale BETWEEN 0 AND 100),sharpness INTEGER NOT NULL DEFAULT 100 CHECK(sharpness BETWEEN 0 AND 100),injury_name VARCHAR(100),return_round INTEGER CHECK(return_round>0),PRIMARY KEY(save_id,player_id),FOREIGN KEY(save_id,player_id) REFERENCES save_players(save_id,player_id) ON DELETE CASCADE);

-- Junior IDs use a reserved identity range, separate from catalog portraits.
CREATE TABLE IF NOT EXISTS league_juniors (id BIGINT GENERATED BY DEFAULT AS IDENTITY (START WITH 1000000000) PRIMARY KEY,save_id VARCHAR(36) NOT NULL,team_id BIGINT NOT NULL,slot INTEGER NOT NULL CHECK(slot BETWEEN 1 AND 18),name VARCHAR(150) NOT NULL,position VARCHAR(12) NOT NULL,ability INTEGER NOT NULL CHECK(ability BETWEEN 1 AND 99),age INTEGER NOT NULL CHECK(age BETWEEN 15 AND 18),potential INTEGER NOT NULL CHECK(potential BETWEEN 1 AND 99),shot_power INTEGER NOT NULL CHECK(shot_power BETWEEN 1 AND 99),long_shots INTEGER NOT NULL CHECK(long_shots BETWEEN 1 AND 99),dribbling INTEGER NOT NULL CHECK(dribbling BETWEEN 1 AND 99),technique INTEGER NOT NULL CHECK(technique BETWEEN 1 AND 99),crossing INTEGER NOT NULL CHECK(crossing BETWEEN 1 AND 99),vision INTEGER NOT NULL CHECK(vision BETWEEN 1 AND 99),finishing INTEGER NOT NULL CHECK(finishing BETWEEN 1 AND 99),short_passing INTEGER NOT NULL CHECK(short_passing BETWEEN 1 AND 99),long_passing INTEGER NOT NULL CHECK(long_passing BETWEEN 1 AND 99),tackling INTEGER NOT NULL CHECK(tackling BETWEEN 1 AND 99),marking INTEGER NOT NULL CHECK(marking BETWEEN 1 AND 99),heading INTEGER NOT NULL CHECK(heading BETWEEN 1 AND 99),first_touch INTEGER NOT NULL CHECK(first_touch BETWEEN 1 AND 99),off_ball INTEGER NOT NULL CHECK(off_ball BETWEEN 1 AND 99),free_kicks INTEGER NOT NULL CHECK(free_kicks BETWEEN 1 AND 99),corners INTEGER NOT NULL CHECK(corners BETWEEN 1 AND 99),penalties INTEGER NOT NULL CHECK(penalties BETWEEN 1 AND 99),anticipation INTEGER NOT NULL CHECK(anticipation BETWEEN 1 AND 99),aggression INTEGER NOT NULL CHECK(aggression BETWEEN 1 AND 99),composure INTEGER NOT NULL CHECK(composure BETWEEN 1 AND 99),concentration INTEGER NOT NULL CHECK(concentration BETWEEN 1 AND 99),decisions INTEGER NOT NULL CHECK(decisions BETWEEN 1 AND 99),determination INTEGER NOT NULL CHECK(determination BETWEEN 1 AND 99),teamwork INTEGER NOT NULL CHECK(teamwork BETWEEN 1 AND 99),leadership INTEGER NOT NULL CHECK(leadership BETWEEN 1 AND 99),consistency INTEGER NOT NULL CHECK(consistency BETWEEN 1 AND 99),acceleration INTEGER NOT NULL CHECK(acceleration BETWEEN 1 AND 99),pace INTEGER NOT NULL CHECK(pace BETWEEN 1 AND 99),work_rate INTEGER NOT NULL CHECK(work_rate BETWEEN 1 AND 99),strength INTEGER NOT NULL CHECK(strength BETWEEN 1 AND 99),agility INTEGER NOT NULL CHECK(agility BETWEEN 1 AND 99),jumping INTEGER NOT NULL CHECK(jumping BETWEEN 1 AND 99),stamina INTEGER NOT NULL CHECK(stamina BETWEEN 1 AND 99),injury_resistance INTEGER NOT NULL CHECK(injury_resistance BETWEEN 1 AND 99),reflexes INTEGER NOT NULL CHECK(reflexes BETWEEN 1 AND 99),handling INTEGER NOT NULL CHECK(handling BETWEEN 1 AND 99),gk_positioning INTEGER NOT NULL CHECK(gk_positioning BETWEEN 1 AND 99),one_on_ones INTEGER NOT NULL CHECK(one_on_ones BETWEEN 1 AND 99),kicking INTEGER NOT NULL CHECK(kicking BETWEEN 1 AND 99),diving INTEGER NOT NULL CHECK(diving BETWEEN 1 AND 99),UNIQUE(save_id,team_id,slot),FOREIGN KEY(save_id,team_id) REFERENCES save_teams(save_id,team_id) ON DELETE CASCADE);

CREATE TABLE IF NOT EXISTS manager_photos(manager_id VARCHAR(36) PRIMARY KEY REFERENCES managers(id) ON DELETE CASCADE,png BYTEA NOT NULL);
ALTER TABLE save_members ADD COLUMN IF NOT EXISTS introduction_seen BOOLEAN NOT NULL DEFAULT FALSE;

ALTER TABLE managers ADD COLUMN IF NOT EXISTS first_name VARCHAR(40);
ALTER TABLE managers ADD COLUMN IF NOT EXISTS last_name VARCHAR(40);
UPDATE managers SET first_name=CASE WHEN POSITION(' ' IN TRIM(name))>0 THEN SUBSTRING(TRIM(name) FROM 1 FOR POSITION(' ' IN TRIM(name))-1) ELSE TRIM(name) END,last_name=CASE WHEN POSITION(' ' IN TRIM(name))>0 THEN TRIM(SUBSTRING(TRIM(name) FROM POSITION(' ' IN TRIM(name))+1)) ELSE NULL END WHERE first_name IS NULL AND last_name IS NULL;

ALTER TABLE league_juniors ADD COLUMN IF NOT EXISTS talent VARCHAR(20) NOT NULL DEFAULT 'REGULAR' CHECK(talent IN ('REGULAR','PROMISING','EXCEPTIONAL'));

ALTER TABLE game_saves ADD COLUMN IF NOT EXISTS calendar_start_date DATE NOT NULL DEFAULT DATE '2026-07-01';
CREATE TABLE IF NOT EXISTS league_calendar_events(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id) ON DELETE CASCADE,team_id BIGINT,event_date DATE NOT NULL,event_type VARCHAR(20) NOT NULL CHECK(event_type IN ('MATCH','TRAINING','TRANSFER','CLUB')),title VARCHAR(150) NOT NULL,description VARCHAR(1000) NOT NULL DEFAULT '',status VARCHAR(20) NOT NULL DEFAULT 'SCHEDULED' CHECK(status IN ('SCHEDULED','COMPLETED','CANCELLED')),FOREIGN KEY(save_id,team_id) REFERENCES save_teams(save_id,team_id) ON DELETE CASCADE);
CREATE INDEX IF NOT EXISTS idx_calendar_events_league_date ON league_calendar_events(save_id,event_date);

CREATE TABLE IF NOT EXISTS national_seasons(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id) ON DELETE CASCADE,league_id BIGINT NOT NULL,season_year INTEGER NOT NULL CHECK(season_year BETWEEN 1900 AND 9998),label VARCHAR(20) NOT NULL,competition_name VARCHAR(150) NOT NULL,country VARCHAR(100) NOT NULL,division INTEGER NOT NULL,team_count INTEGER NOT NULL CHECK(team_count>1),rounds INTEGER NOT NULL CHECK(rounds>0),first_date DATE NOT NULL,last_date DATE NOT NULL,draw_seed BIGINT NOT NULL,format VARCHAR(40) NOT NULL,UNIQUE(save_id,league_id,season_year),UNIQUE(save_id,id),CHECK(last_date>first_date));
CREATE TABLE IF NOT EXISTS national_season_teams(save_id VARCHAR(36) NOT NULL,season_id BIGINT NOT NULL,team_id BIGINT NOT NULL,team_name VARCHAR(150) NOT NULL,PRIMARY KEY(save_id,season_id,team_id),FOREIGN KEY(save_id,season_id) REFERENCES national_seasons(save_id,id) ON DELETE CASCADE,FOREIGN KEY(save_id,team_id) REFERENCES save_teams(save_id,team_id) ON DELETE CASCADE);
CREATE TABLE IF NOT EXISTS national_fixtures(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,save_id VARCHAR(36) NOT NULL,season_id BIGINT NOT NULL,round_number INTEGER NOT NULL CHECK(round_number>0),match_date DATE NOT NULL,home_team_id BIGINT NOT NULL,away_team_id BIGINT NOT NULL,status VARCHAR(20) NOT NULL DEFAULT 'SCHEDULED' CHECK(status IN ('SCHEDULED','PLAYED','CANCELLED')),home_goals INTEGER,away_goals INTEGER,FOREIGN KEY(save_id,season_id) REFERENCES national_seasons(save_id,id) ON DELETE CASCADE,FOREIGN KEY(save_id,season_id,home_team_id) REFERENCES national_season_teams(save_id,season_id,team_id) ON DELETE CASCADE,FOREIGN KEY(save_id,season_id,away_team_id) REFERENCES national_season_teams(save_id,season_id,team_id) ON DELETE CASCADE,UNIQUE(season_id,home_team_id,away_team_id),UNIQUE(season_id,round_number,home_team_id),UNIQUE(season_id,round_number,away_team_id),CHECK(home_team_id<>away_team_id),CHECK(home_goals IS NULL OR home_goals>=0),CHECK(away_goals IS NULL OR away_goals>=0),CHECK((home_goals IS NULL AND away_goals IS NULL) OR (home_goals IS NOT NULL AND away_goals IS NOT NULL)));
CREATE INDEX IF NOT EXISTS idx_national_fixtures_calendar ON national_fixtures(save_id,match_date);
CREATE INDEX IF NOT EXISTS idx_national_fixtures_season_status_date ON national_fixtures(save_id,season_id,status,match_date);
CREATE INDEX IF NOT EXISTS idx_national_fixtures_home_status_date ON national_fixtures(save_id,home_team_id,status,match_date,id);
CREATE INDEX IF NOT EXISTS idx_national_fixtures_away_status_date ON national_fixtures(save_id,away_team_id,status,match_date,id);
CREATE INDEX IF NOT EXISTS idx_save_players_team ON save_players(save_id,team_id);

CREATE TABLE IF NOT EXISTS match_sessions (
    fixture_id BIGINT PRIMARY KEY REFERENCES national_fixtures(id) ON DELETE CASCADE,
    save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id) ON DELETE CASCADE,
    state_json TEXT NOT NULL, revision BIGINT NOT NULL DEFAULT 0,
    next_tick_at TIMESTAMP NOT NULL, finished BOOLEAN NOT NULL DEFAULT FALSE
);
CREATE INDEX IF NOT EXISTS idx_match_sessions_due ON match_sessions(save_id,finished,next_tick_at);
-- Legacy READY rooms require a fresh confirmation before the new engine starts automatically.
ALTER TABLE game_saves ADD COLUMN IF NOT EXISTS matchday_pending BOOLEAN NOT NULL DEFAULT FALSE;
ALTER TABLE game_saves ADD COLUMN IF NOT EXISTS matchday_sequence BIGINT NOT NULL DEFAULT 0;
ALTER TABLE game_saves ADD COLUMN IF NOT EXISTS local_multiplayer BOOLEAN NOT NULL DEFAULT FALSE;
ALTER TABLE game_saves ADD COLUMN IF NOT EXISTS match_speed_percent INTEGER NOT NULL DEFAULT 100 CHECK (match_speed_percent BETWEEN 50 AND 400);
ALTER TABLE save_teams ADD COLUMN IF NOT EXISTS calendar_day INTEGER;
ALTER TABLE match_sessions ADD COLUMN IF NOT EXISTS batch_number BIGINT NOT NULL DEFAULT 0;
CREATE TABLE IF NOT EXISTS match_player_seasons (
    save_id VARCHAR(36) NOT NULL, season_id BIGINT NOT NULL, player_id BIGINT NOT NULL,
    yellow_count INTEGER NOT NULL DEFAULT 0, suspension_remaining INTEGER NOT NULL DEFAULT 0,
    appearances INTEGER NOT NULL DEFAULT 0, minutes INTEGER NOT NULL DEFAULT 0,
    goals INTEGER NOT NULL DEFAULT 0, assists INTEGER NOT NULL DEFAULT 0,
    passes_completed INTEGER NOT NULL DEFAULT 0, passes_missed INTEGER NOT NULL DEFAULT 0,
    shots INTEGER NOT NULL DEFAULT 0, saves INTEGER NOT NULL DEFAULT 0,
    yellow_cards INTEGER NOT NULL DEFAULT 0, red_cards INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(save_id,season_id,player_id),
    FOREIGN KEY(save_id,season_id) REFERENCES national_seasons(save_id,id) ON DELETE CASCADE,
    FOREIGN KEY(save_id,player_id) REFERENCES save_players(save_id,player_id) ON DELETE CASCADE
);

ALTER TABLE save_team_management ADD COLUMN IF NOT EXISTS tactical_plan TEXT NOT NULL DEFAULT '{}';
-- Season finance, estimated market values and negotiations belong to each league snapshot.
ALTER TABLE catalog_players ADD COLUMN IF NOT EXISTS market_value BIGINT NOT NULL DEFAULT 0 CHECK(market_value>=0);
ALTER TABLE save_players ADD COLUMN IF NOT EXISTS market_value BIGINT NOT NULL DEFAULT 0 CHECK(market_value>=0);
ALTER TABLE save_players ALTER COLUMN team_id DROP NOT NULL;
CREATE TABLE IF NOT EXISTS club_finance_accounts(
 save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id) ON DELETE CASCADE,team_id BIGINT NOT NULL,
 last_processed_date DATE NOT NULL,staff_salary_monthly BIGINT NOT NULL DEFAULT 0 CHECK(staff_salary_monthly>=0),
 board_trust INTEGER NOT NULL DEFAULT 60 CHECK(board_trust BETWEEN 0 AND 100),
 PRIMARY KEY(save_id,team_id),FOREIGN KEY(save_id,team_id) REFERENCES save_teams(save_id,team_id) ON DELETE CASCADE);
CREATE TABLE IF NOT EXISTS player_contracts(
 save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id) ON DELETE CASCADE,player_id BIGINT NOT NULL,team_id BIGINT,
 salary_monthly BIGINT NOT NULL CHECK(salary_monthly>=0),start_date DATE NOT NULL,end_date DATE NOT NULL,
 signing_bonus BIGINT NOT NULL DEFAULT 0 CHECK(signing_bonus>=0),appearance_bonus BIGINT NOT NULL DEFAULT 0 CHECK(appearance_bonus>=0),
 goal_bonus BIGINT NOT NULL DEFAULT 0 CHECK(goal_bonus>=0),title_bonus BIGINT NOT NULL DEFAULT 0 CHECK(title_bonus>=0),
 estimated BOOLEAN NOT NULL DEFAULT TRUE,PRIMARY KEY(save_id,player_id),
 FOREIGN KEY(save_id,player_id) REFERENCES save_players(save_id,player_id) ON DELETE CASCADE,
 FOREIGN KEY(save_id,team_id) REFERENCES save_teams(save_id,team_id) ON DELETE CASCADE,CHECK(end_date>=start_date));
CREATE TABLE IF NOT EXISTS season_finances(
 id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id) ON DELETE CASCADE,
 team_id BIGINT NOT NULL,season_id BIGINT NOT NULL REFERENCES national_seasons(id) ON DELETE CASCADE,
 approved BOOLEAN NOT NULL DEFAULT FALSE,promised_rank INTEGER NOT NULL DEFAULT 1 CHECK(promised_rank>0),
 base_funding BIGINT NOT NULL CHECK(base_funding>=0),transfer_budget BIGINT NOT NULL DEFAULT 0 CHECK(transfer_budget>=0),
 salary_budget BIGINT NOT NULL DEFAULT 0 CHECK(salary_budget>=0),infrastructure_budget BIGINT NOT NULL DEFAULT 0 CHECK(infrastructure_budget>=0),
 miscellaneous_budget BIGINT NOT NULL DEFAULT 0 CHECK(miscellaneous_budget>=0),reserve_budget BIGINT NOT NULL DEFAULT 0 CHECK(reserve_budget>=0),
 transfer_spent BIGINT NOT NULL DEFAULT 0,final_rank INTEGER,promise_met BOOLEAN,settled BOOLEAN NOT NULL DEFAULT FALSE,
 UNIQUE(save_id,team_id,season_id),FOREIGN KEY(save_id,team_id) REFERENCES save_teams(save_id,team_id) ON DELETE CASCADE);
CREATE TABLE IF NOT EXISTS finance_ledger(
 id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id) ON DELETE CASCADE,
 team_id BIGINT NOT NULL,event_date DATE NOT NULL,category VARCHAR(30) NOT NULL,description VARCHAR(250) NOT NULL,
 amount BIGINT NOT NULL,entry_key VARCHAR(120) NOT NULL,UNIQUE(save_id,team_id,entry_key),
 FOREIGN KEY(save_id,team_id) REFERENCES save_teams(save_id,team_id) ON DELETE CASCADE);
CREATE TABLE IF NOT EXISTS transfer_offers(
 id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id) ON DELETE CASCADE,
 player_id BIGINT NOT NULL,buyer_id BIGINT NOT NULL,seller_id BIGINT,season_id BIGINT NOT NULL REFERENCES national_seasons(id) ON DELETE CASCADE,
 status VARCHAR(20) NOT NULL CHECK(status IN ('CLUB_REVIEW','PENDING','NEGOTIABLE','ACCEPTED','REJECTED','CANCELLED','EXPIRED')),
 club_meter INTEGER NOT NULL CHECK(club_meter BETWEEN 0 AND 100),player_meter INTEGER NOT NULL CHECK(player_meter BETWEEN 0 AND 100),
 fee BIGINT NOT NULL CHECK(fee>=0),salary_monthly BIGINT NOT NULL CHECK(salary_monthly>0),months INTEGER NOT NULL CHECK(months BETWEEN 6 AND 60),
 signing_bonus BIGINT NOT NULL DEFAULT 0 CHECK(signing_bonus>=0),appearance_bonus BIGINT NOT NULL DEFAULT 0 CHECK(appearance_bonus>=0),
 goal_bonus BIGINT NOT NULL DEFAULT 0 CHECK(goal_bonus>=0),title_bonus BIGINT NOT NULL DEFAULT 0 CHECK(title_bonus>=0),
 offered_date DATE NOT NULL,decision_date DATE,expires_date DATE NOT NULL,seller_approved BOOLEAN NOT NULL DEFAULT FALSE,
 feedback VARCHAR(1000) NOT NULL,revision INTEGER NOT NULL DEFAULT 0,
 FOREIGN KEY(save_id,player_id) REFERENCES save_players(save_id,player_id) ON DELETE CASCADE,
 FOREIGN KEY(save_id,buyer_id) REFERENCES save_teams(save_id,team_id) ON DELETE CASCADE,
 FOREIGN KEY(save_id,seller_id) REFERENCES save_teams(save_id,team_id) ON DELETE CASCADE);
CREATE INDEX IF NOT EXISTS idx_offers_due ON transfer_offers(save_id,buyer_id,status,decision_date);

-- Confidence in the coach and the preseason strength snapshot.
ALTER TABLE club_finance_accounts ADD COLUMN IF NOT EXISTS fan_trust INTEGER NOT NULL DEFAULT 60 CHECK(fan_trust BETWEEN 0 AND 100);
ALTER TABLE season_finances ADD COLUMN IF NOT EXISTS expected_rank INTEGER;

-- Valuation model version; existing manual/imported values remain authoritative.
ALTER TABLE catalog_players ADD COLUMN IF NOT EXISTS valuation_version INTEGER NOT NULL DEFAULT 0;
ALTER TABLE save_players ADD COLUMN IF NOT EXISTS valuation_version INTEGER NOT NULL DEFAULT 0;
ALTER TABLE season_finances ADD COLUMN IF NOT EXISTS funding_version INTEGER NOT NULL DEFAULT 0;

-- Official knockout editions, distinct from domestic league budgets.
CREATE TABLE IF NOT EXISTS tournament_entries(competition_key VARCHAR(60) NOT NULL,season_year INTEGER NOT NULL,team_id BIGINT NOT NULL REFERENCES catalog_teams(id) ON DELETE CASCADE,entry_stage VARCHAR(40) NOT NULL,seed_rank INTEGER NOT NULL DEFAULT 0,association VARCHAR(100),region VARCHAR(100),source_url VARCHAR(1000),PRIMARY KEY(competition_key,season_year,team_id));
CREATE TABLE IF NOT EXISTS tournament_editions(id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id) ON DELETE CASCADE,competition_key VARCHAR(60) NOT NULL,season_year INTEGER NOT NULL,label VARCHAR(30) NOT NULL,name VARCHAR(150) NOT NULL,country VARCHAR(100) NOT NULL,status VARCHAR(30) NOT NULL DEFAULT 'ACTIVE',rulebook TEXT NOT NULL,current_stage INTEGER NOT NULL DEFAULT 0,champion_id BIGINT,runner_up_id BIGINT,UNIQUE(save_id,competition_key,season_year),UNIQUE(save_id,id));
CREATE TABLE IF NOT EXISTS tournament_teams(save_id VARCHAR(36) NOT NULL,edition_id BIGINT NOT NULL,team_id BIGINT NOT NULL,entry_stage VARCHAR(40) NOT NULL,seed_rank INTEGER NOT NULL,association VARCHAR(100),region VARCHAR(100),PRIMARY KEY(edition_id,team_id),FOREIGN KEY(save_id,edition_id) REFERENCES tournament_editions(save_id,id) ON DELETE CASCADE,FOREIGN KEY(save_id,team_id) REFERENCES save_teams(save_id,team_id) ON DELETE CASCADE);
ALTER TABLE national_seasons ADD COLUMN IF NOT EXISTS tournament_id BIGINT REFERENCES tournament_editions(id) ON DELETE CASCADE;
ALTER TABLE national_seasons ADD COLUMN IF NOT EXISTS tournament_stage INTEGER;
ALTER TABLE national_fixtures ADD COLUMN IF NOT EXISTS tie_number INTEGER;
ALTER TABLE national_fixtures ADD COLUMN IF NOT EXISTS leg_number INTEGER;
ALTER TABLE national_fixtures ADD COLUMN IF NOT EXISTS home_penalties INTEGER;
ALTER TABLE national_fixtures ADD COLUMN IF NOT EXISTS away_penalties INTEGER;
CREATE TABLE IF NOT EXISTS tournament_ties(edition_id BIGINT NOT NULL REFERENCES tournament_editions(id) ON DELETE CASCADE,stage_index INTEGER NOT NULL,tie_number INTEGER NOT NULL,home_team_id BIGINT NOT NULL,away_team_id BIGINT NOT NULL,winner_id BIGINT,PRIMARY KEY(edition_id,stage_index,tie_number));
CREATE TABLE IF NOT EXISTS competition_qualifications(save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id) ON DELETE CASCADE,target_key VARCHAR(60) NOT NULL,target_year INTEGER NOT NULL,team_id BIGINT NOT NULL,source_key VARCHAR(60) NOT NULL,source_year INTEGER NOT NULL,qualification_type VARCHAR(60) NOT NULL,confirmed_date DATE NOT NULL,PRIMARY KEY(save_id,target_key,target_year,team_id,source_key,source_year,qualification_type),FOREIGN KEY(save_id,team_id) REFERENCES save_teams(save_id,team_id) ON DELETE CASCADE);

ALTER TABLE national_season_teams ADD COLUMN IF NOT EXISTS group_name VARCHAR(80);

CREATE TABLE IF NOT EXISTS tournament_advancements(edition_id BIGINT NOT NULL REFERENCES tournament_editions(id) ON DELETE CASCADE,stage_index INTEGER NOT NULL,team_id BIGINT NOT NULL,seed_rank INTEGER NOT NULL,source_group VARCHAR(80),PRIMARY KEY(edition_id,stage_index,team_id));

-- Immutable real-world baselines. They are not simulated fixtures or current-season points.
CREATE TABLE IF NOT EXISTS historical_seasons(
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    league_id BIGINT NOT NULL REFERENCES catalog_leagues(id),season_year INTEGER NOT NULL,
    label VARCHAR(40) NOT NULL,name VARCHAR(150) NOT NULL,country VARCHAR(100) NOT NULL,
    first_date DATE NOT NULL,last_date DATE NOT NULL,source_url VARCHAR(1000) NOT NULL,
    UNIQUE(league_id,season_year)
);
CREATE TABLE IF NOT EXISTS historical_standings(
    season_id BIGINT NOT NULL REFERENCES historical_seasons(id) ON DELETE CASCADE,
    team_id BIGINT NOT NULL REFERENCES catalog_teams(id),team_name VARCHAR(150) NOT NULL,
    position INTEGER NOT NULL,played INTEGER NOT NULL,wins INTEGER NOT NULL,draws INTEGER NOT NULL,
    losses INTEGER NOT NULL,goals_for INTEGER NOT NULL,goals_against INTEGER NOT NULL,points INTEGER NOT NULL,
    PRIMARY KEY(season_id,team_id),UNIQUE(season_id,position)
);
CREATE TABLE IF NOT EXISTS save_historical_seasons(
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id) ON DELETE CASCADE,
    league_id BIGINT NOT NULL,season_year INTEGER NOT NULL,label VARCHAR(40) NOT NULL,
    name VARCHAR(150) NOT NULL,country VARCHAR(100) NOT NULL,first_date DATE NOT NULL,last_date DATE NOT NULL,
    source_url VARCHAR(1000) NOT NULL,UNIQUE(save_id,league_id,season_year)
);
CREATE TABLE IF NOT EXISTS save_historical_standings(
    season_id BIGINT NOT NULL REFERENCES save_historical_seasons(id) ON DELETE CASCADE,
    team_id BIGINT NOT NULL,team_name VARCHAR(150) NOT NULL,position INTEGER NOT NULL,
    played INTEGER NOT NULL,wins INTEGER NOT NULL,draws INTEGER NOT NULL,losses INTEGER NOT NULL,
    goals_for INTEGER NOT NULL,goals_against INTEGER NOT NULL,points INTEGER NOT NULL,
    PRIMARY KEY(season_id,team_id),UNIQUE(season_id,position)
);

CREATE TABLE IF NOT EXISTS tournament_draws(
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id) ON DELETE CASCADE,
    edition_id BIGINT NOT NULL REFERENCES tournament_editions(id) ON DELETE CASCADE,
    stage_index INTEGER NOT NULL,draw_date DATE NOT NULL,started_at BIGINT NOT NULL,payload TEXT NOT NULL,
    UNIQUE(edition_id,stage_index)
);
CREATE TABLE IF NOT EXISTS tournament_draw_views(
    draw_id BIGINT NOT NULL REFERENCES tournament_draws(id) ON DELETE CASCADE,
    member_id VARCHAR(36) NOT NULL REFERENCES save_members(id) ON DELETE CASCADE,
    PRIMARY KEY(draw_id,member_id)
);

-- Match performance history; old seasons retain an unknown average until new rated games.
ALTER TABLE match_player_seasons ADD COLUMN IF NOT EXISTS rating_total DECIMAL(12,1) NOT NULL DEFAULT 0;
ALTER TABLE match_player_seasons ADD COLUMN IF NOT EXISTS rated_appearances INTEGER NOT NULL DEFAULT 0;
CREATE TABLE IF NOT EXISTS match_player_ratings (save_id VARCHAR(36) NOT NULL REFERENCES game_saves(id) ON DELETE CASCADE,fixture_id BIGINT NOT NULL REFERENCES national_fixtures(id) ON DELETE CASCADE,player_id BIGINT NOT NULL,minutes INTEGER NOT NULL,rating DECIMAL(3,1),PRIMARY KEY(save_id,fixture_id,player_id),FOREIGN KEY(save_id,player_id) REFERENCES save_players(save_id,player_id) ON DELETE CASCADE);
